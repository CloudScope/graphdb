# TigerGraph Savanna credentials. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
#
# Needed only for --store savanna (DESIGN.md phases 2, 3, 6, 7).
# Everything else runs offline against the SQLite LocalStore.
#
# ---------------------------------------------------------------------------
# HOW TO GET THESE — see docs/tigergraph-setup.md for the full walkthrough
# ---------------------------------------------------------------------------
# TG_HOST    Savanna console -> your workspace -> Connect -> "Connect from API".
#            Copy the workspace hostname. Looks like:
#              https://abcd1234.i.tgcloud.io
#            Include the https:// scheme.
#
# TG_GRAPH   The graph name. It must EXIST before a graph-scoped secret can be
#            made, so create an empty graph called PaySentry first (Savanna's
#            GSQL editor: CREATE GRAPH PaySentry ()).
#
# TG_SECRET  A *database secret* — NOT a Savanna API key. The two are different:
#            an API key authenticates Savanna's management API, a database
#            secret authenticates the graph itself, and pyTigerGraph wants the
#            latter (it passes it as gsqlSecret).
#            Get one from the workspace's Admin Portal -> My Profile -> "+" next
#            to Secrets. Copy it immediately; it is shown once.
#            Or from the GSQL editor:  CREATE SECRET s1
# ---------------------------------------------------------------------------

TG_HOST=
TG_GRAPH=PaySentry
TG_SECRET=

# Optional. Cloud workspaces terminate TLS on 443 for both REST++ and GSQL, so
# these rarely need changing. Set them only for a self-hosted instance.
TG_REST_PORT=443
TG_GSQL_PORT=443

# Optional fallback. TigerGraph Cloud does not use username/password auth —
# leave these blank unless you are pointing at a self-hosted TigerGraph.
TG_USER=
TG_PASSWORD=
